# Python virtual environment (recreate with: python3 -m venv .venv && pip install maturin)
.venv/

# Large data: never push multi-hundred-MB / multi-GB FITS or Parquet files
# to git. Fetch real Euclid tiles with scripts/download_real_data.py.
data/*.fits
data/*.parquet
data/real/

__pycache__/
*.pyc

# Rust build output (also covered by euclidrust/.gitignore, redundancy is fine)
euclidrust/target/

# Personal notes, not part of the public repo
base.txt